# Hidden Gem 환경변수 템플릿 - 값을 채운 뒤 .env로 복사해서 사용
# cp .env.example .env

# ── Database (docker compose 기본값과 일치) ─────────────────
DB_PASSWORD=change-me
DATABASE_URL=postgresql://juntae:change-me@db:5432/hidden_gem_db

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Steam (https://steamcommunity.com/dev/apikey) ──────────
STEAM_API_KEY=

# ── Google OAuth (Google Cloud Console) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Django ──────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
FRONTEND_URL=http://localhost:3000
# 운영에서만: setup_oauth.py가 Site 도메인으로 사용
# SITE_DOMAIN=your-backend.up.railway.app

# ── 모니터링/알림 (선택) ─────────────────────────────────────
SENTRY_DSN=
SENTRY_ENV=development
DISCORD_WEBHOOK_URL=

# ── Django Admin 계정 (FastAPI /taste/stats 보호용) ──────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 신작 노출 게이트: Steam 리뷰 수가 이 값 미만이면 분석은 하되 is_active=FALSE (기본 10)
MIN_REVIEWS_FOR_EXPOSURE=10

# OpenAI 배치 단가 (USD / 1M tok, Batch 50% 할인 적용가). 학생 모델 단가를 공식 가격표에서
# 확인해 넣으면 batch_generator 예상 비용과 usage_report 환산에 사용된다. 비우면 토큰만 표시.
OPENAI_PRICE_INPUT_PER_M=
OPENAI_PRICE_OUTPUT_PER_M=

# 운영 엔드포인트(/ops/*) 토큰. 운영에서는 필수 — 비어 있으면 503 으로 막힌다.
# 생성: openssl rand -hex 32
OPS_TOKEN=
